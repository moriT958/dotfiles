{
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "cursor_shape": "bar",
  "sticky_scroll": {
    "enabled": true
  },
  "buffer_font_family": "PlemolJP Console NF",
  "buffer_font_size": 11.5,
  "buffer_line_height": "comfortable",
  "ui_font_size": 12.5,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "agent": {
    "dock": "left",
    "sidebar_side": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "expand_outlines_with_depth": 0,
    "auto_fold_dirs": true,
    "file_icons": true,
    "indent_size": 15.0,
    "dock": "left"
  },
  "project_panel": {
    "indent_guides": {
      "show": "always"
    },
    "indent_size": 10.0,
    "entry_spacing": "standard",
    "dock": "left",
    "auto_reveal_entries": true
  }
}
