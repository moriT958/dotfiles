// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "cli_default_open_behavior": "existing_window",
  "sticky_scroll": {
    "enabled": true
  },
  "show_edit_predictions": true,
  "agent": {
    "expand_terminal_card": false,
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^go\\s+test(\\s|$)"
            }
          ]
        },
        "create_directory": {
          "always_allow": [
            {
              "pattern": "^dino-game/cmd/"
            },
            {
              "pattern": "^dino-game/internal/"
            }
          ]
        }
      }
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
      "effort": "high",
    },
    "sidebar_side": "left",
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "expand_outlines_with_depth": 0,
    "auto_fold_dirs": true,
    "file_icons": true,
    "indent_size": 15.0,
    "dock": "left",
  },
  "project_panel": {
    "indent_guides": {
      "show": "always",
    },
    "indent_size": 10.0,
    "entry_spacing": "standard",
    "dock": "left",
    "auto_reveal_entries": true
  },
  "cursor_shape": "bar",
  "buffer_line_height": "comfortable",
  "buffer_font_family": "PlemolJP Console NF",
  "ui_font_weight": 400.0,
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "fast": false,
        "model": "default",
        "mode": "auto"
      },
      "type": "registry",
    },
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé",
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "ui_font_size": 12.5,
  "buffer_font_size": 11.5,
  "agent_ui_font_size": 13.5,
  "languages": {
    "Markdown": {
      "show_edit_predictions": false
    },
    "Ruby": {
      "language_servers": ["ruby-lsp"],
    },
  },
  "lsp": {
    "ruby-lsp": {
      "settings": {
        "use_bundler": false,
      },
    },
  },
}
